    "test:watch": "vitest"
  },
  "devDependencies": {
    "terser": "^5.51.2",
    "typescript": "~5.7.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
