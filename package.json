{
  "name": "altitude-of-the-fallen",
  "description": "Altitude of the Fallen - a 2D top-down pixel-art game built with Phaser 4, TypeScript and Vite.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
